{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  // The shared agent, memory, schedule and media types are committed before the code that imports them. Drop a
  // file's line once every one of its types has an importer.
  "ignoreIssues": {
    "services/src/threads/types.ts": ["types"]
  },
  "workspaces": {
    "infra": {
      "entry": [
        "bin/app.ts"
      ],
      "project": [
        "bin/**/*.ts",
        "lib/**/*.ts"
      ],
      "ignoreDependencies": [
        "esbuild"
      ]
    },
    "services": {
      "entry": [
        "src/**/handler.ts",
        "src/health.ts",
        "src/auth/presignup.ts",
        "src/runs/loop.ts",
        "src/runs/stream-handler.ts",
        "src/spike/*.ts",
        "src/**/*.live.test.ts",
        "src/**/*.load.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "scripts": {
      "entry": [
        "src/{floci-up,deploy-local,spike-check,spike-aws,grant,smoke,dev,stream-local,sandbox-local,mcp-test-local}.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "web": {
      "entry": [
        "open-next.config.ts"
      ],
      "project": [
        "**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "tailwindcss",
        "postcss"
      ]
    }
  }
}
