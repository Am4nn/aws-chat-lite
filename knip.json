{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreIssues": {
    "services/src/budget/model.ts": ["exports"],
    "services/src/runs/model.ts": ["exports"],
    "services/src/threads/types.ts": ["types"]
  },
  "workspaces": {
    "infra": {
      "entry": [
        "bin/app.ts"
      ],
      "project": [
        "bin/**/*.ts",
        "lib/**/*.ts"
      ],
      "ignoreDependencies": [
        "esbuild"
      ]
    },
    "services": {
      "entry": [
        "src/**/handler.ts",
        "src/health.ts",
        "src/auth/presignup.ts",
        "src/spike/*.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "scripts": {
      "entry": [
        "src/{floci-up,deploy-local,spike-check,spike-aws,grant,smoke}.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "web": {
      "ignore": ["lib/client/sound.ts"],
      "project": [
        "**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "tailwindcss",
        "postcss"
      ]
    }
  }
}
