{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    "infra": {
      "entry": [
        "bin/app.ts"
      ],
      "project": [
        "bin/**/*.ts",
        "lib/**/*.ts"
      ],
      "ignoreDependencies": [
        "esbuild"
      ]
    },
    "services": {
      "entry": [
        "src/**/handler.ts",
        "src/health.ts",
        "src/auth/presignup.ts",
        "src/runs/loop.ts",
        "src/runs/stream-handler.ts",
        "src/schedules/fire.ts",
        "src/**/*.live.test.ts",
        "src/**/*.load.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "scripts": {
      "entry": [
        "src/{floci-up,deploy-local,grant,smoke,dev,stream-local,sandbox-local,mcp-test-local,fire-schedule}.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "web": {
      "entry": [
        "open-next.config.ts"
      ],
      "project": [
        "**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "tailwindcss",
        "postcss"
      ]
    }
  }
}
