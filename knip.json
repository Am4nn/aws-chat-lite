{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "ignoreIssues": {
    "services/src/models/catalog.ts": [
      "exports",
      "types"
    ],
    "web/lib/types.ts": [
      "types"
    ],
    "services/src/tools/types.ts": [
      "types"
    ]
  },
  "workspaces": {
    "infra": {
      "entry": [
        "bin/app.ts"
      ],
      "project": [
        "bin/**/*.ts",
        "lib/**/*.ts"
      ],
      "ignoreDependencies": [
        "esbuild"
      ]
    },
    "services": {
      "entry": [
        "src/**/handler.ts",
        "src/health.ts",
        "src/auth/presignup.ts",
        "src/runs/loop.ts",
        "src/runs/stream-handler.ts",
        "src/spike/*.ts",
        "src/**/*.live.test.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "scripts": {
      "entry": [
        "src/{floci-up,deploy-local,spike-check,spike-aws,grant,smoke,dev,stream-local}.ts"
      ],
      "project": [
        "src/**/*.ts"
      ]
    },
    "web": {
      "project": [
        "**/*.{ts,tsx}"
      ],
      "ignoreDependencies": [
        "tailwindcss",
        "postcss"
      ]
    }
  }
}
