{
  "name": "chat-lite",
  "private": true,
  "workspaces": [
    "infra",
    "services",
    "scripts",
    "web"
  ],
  "scripts": {
    "floci:up": "npm -w scripts run floci-up",
    "floci:down": "docker compose down",
    "test": "npm run test --workspaces --if-present",
    "deploy:local": "npm -w scripts run deploy-local --",
    "spike": "npm -w scripts run spike",
    "spike:aws": "npm -w scripts run spike-aws",
    "grant": "npm -w scripts run grant --",
    "dev": "npm -w scripts run dev",
    "stream:local": "npm -w scripts run stream-local",
    "sandbox:build": "docker build -t cl-sandbox:1 scripts/sandbox-image",
    "sandbox:local": "npm -w scripts run sandbox-local",
    "smoke": "npm -w scripts run smoke",
    "schedule:fire": "npm -w scripts run schedule-fire --",
    "check": "knip && npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22",
    "knip": "^5.88.1",
    "tsx": "^4",
    "typescript": "^5",
    "vitest": "^5"
  }
}
